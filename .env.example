# Copiá este archivo a .env y cambiá los valores. .env no se versiona.
# Las contraseñas de abajo son ficticias y solo sirven como plantilla.
# En el servidor (docker compose) este archivo va en la raíz del proyecto, junto a docker-compose.yml.

# development muestra más detalle en errores. En el servidor usá production.
ENVIRONMENT=development

# Puerto público donde se sirve la aplicación con docker compose (80 = http://IP-del-servidor)
APP_PORT=80

# Base de datos.
# Con docker compose no hace falta tocar DATABASE_URL: se arma sola con los POSTGRES_* de abajo.
# Para desarrollo local sin Docker podés usar SQLite:
# DATABASE_URL=sqlite:///./data/conkreto.db
DATABASE_URL=postgresql+psycopg://conkreto:conkreto_dev_change_me@localhost:5432/conkreto

# PostgreSQL de docker compose. Usá una contraseña larga con solo letras y números
# (los símbolos como @ : / # rompen la URL de conexión).
POSTGRES_USER=conkreto
POSTGRES_PASSWORD=conkreto_dev_change_me
POSTGRES_DB=conkreto

# Clave para firmar las sesiones (JWT). En producción: mínimo 32 caracteres aleatorios.
# Generala con: openssl rand -hex 32
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Duración de la sesión
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Direcciones desde donde se abre la aplicación, separadas por coma.
# Ejemplo servidor: http://69.197.176.243  (o https://tudominio.com si usás dominio)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Cuenta inicial de sysadmin. Se crea una sola vez si el usuario no existe.
# No se restablece la contraseña en reinicios posteriores.
# En producción: mínimo 10 caracteres y distinta de la de ejemplo.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@conkreto.local
INITIAL_ADMIN_PASSWORD=cambiame-admin-inicial

# Archivos adjuntos (no quedan expuestos por URL pública).
# Con docker compose se fuerza a /app/data/uploads dentro de un volumen.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Intentos de inicio de sesión
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Correo para avisos de cobro a clientes (opcional).
# Si SMTP_HOST o SMTP_FROM quedan vacíos, los avisos se mandan a mano con los botones de WhatsApp y Correo.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
#        SMTP_USERNAME y SMTP_FROM = la cuenta de Gmail,
#        SMTP_PASSWORD = una "contraseña de aplicación" de 16 letras (no la contraseña normal;
#        requiere verificación en dos pasos: https://myaccount.google.com/apppasswords).
# SMTP_SECURITY: starttls (puerto 587), ssl (puerto 465) o none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Conkreto
# A dónde llegan las respuestas del cliente (vacío = SMTP_FROM)
SMTP_REPLY_TO=
# Copia oculta de cada aviso para la empresa, separadas por coma (opcional)
SMTP_BCC=

# Envío automático: true lo manda solo; false deja únicamente el botón "Enviar correo".
NOTICES_AUTO_SEND=true
# Franja horaria (hora de Argentina) en la que se mandan los avisos automáticos
NOTICES_SEND_HOUR=9
NOTICES_SEND_UNTIL_HOUR=20
# Cada cuántos minutos revisa si hay avisos para mandar
NOTICES_CHECK_MINUTES=30
